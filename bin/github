#!/bin/sh
# With nodenv, pin to the global version so a project's .node-version can't hide or break the command.
cli="$(dirname "$(realpath "$0")")/../dist/cli.js"
if command -v nodenv >/dev/null 2>&1; then
	exec env NODENV_VERSION="$(nodenv global)" nodenv exec node "$cli" "$@"
fi
exec node "$cli" "$@"
