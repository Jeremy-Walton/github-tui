{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
						"timeout": 60,
						"statusMessage": "Formatting, linting, and typechecking"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/on-stop.mjs\"",
						"timeout": 180,
						"statusMessage": "Running npm run check"
					}
				]
			}
		]
	}
}
